{
  "name": "monchu",
  "version": "1.0.0",
  "private": true,
  "description": "A heavily opinionated personal agent that routes and delegates endeavors: one input stream of consciousness in, durable workstreams out",
  "keywords": [
    "agent",
    "pi-durable"
  ],
  "homepage": "https://github.com/jorgeavaldez/monchu",
  "license": "MIT",
  "author": "Jorge Valdez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgeavaldez/monchu.git"
  },
  "bin": {
    "monchu": "dist/main.js"
  },
  "files": [
    "dist",
    "skills",
    "home-template",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@ff-labs/fff-node": "0.11.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "cc-session-io": "0.4.0",
    "chalk": "6.0.0",
    "diff": "8.0.4",
    "highlight.js": "10.7.3",
    "ignore": "7.0.8",
    "jose": "6.2.12",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "ws": "8.22.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@preact/signals": "2.11.3",
    "@types/node": "^26.6.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.2",
    "@xterm/headless": "5.5.0",
    "esbuild": "0.28.2",
    "knip": "6.41.0",
    "oxc-parser": "0.153.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "preact": "11.0.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  },
  "knip": {
    "ignoreBinaries": [
      "jj",
      "agent-browser"
    ],
    "entry": [
      "src/web/main.tsx",
      "src/web/worker/sw.ts"
    ]
  }
}
