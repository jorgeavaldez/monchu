    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
