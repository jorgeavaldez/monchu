{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/tui/*", "./tui/*"],
            "message": "Only src/main.ts composes the TUI; the core never imports a client."
          },
          {
            "group": ["**/ui/*", "./ui/*"],
            "message": "The shared UI layer is for clients only; the core stays UI-free."
          },
          {
            "group": ["**/test/*", "../test/*"],
            "message": "Source never imports test code."
          },
          {
            "group": ["**/reexec.ts", "./reexec.ts"],
            "message": "Only src/main.ts re-executes the process."
          },
          {
            "group": ["./server/*", "../server/*", "../../server/*", "../../../server/*"],
            "message": "Only src/main.ts composes the server; the core and clients never import it."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/main.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/test/*", "../test/*"],
                "message": "Source never imports test code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "Shared with browser clients: no Node modules."
              },
              {
                "group": ["**/core/*", "**/core/**"],
                "allowTypeImports": true,
                "message": "src/api takes core types only, never core code."
              },
              {
                "group": ["**/ui/*", "**/tui/*"],
                "message": "src/api is the contract: it depends on no client."
              },
              {
                "group": ["**/test/*", "../test/*"],
                "message": "Source never imports test code."
              },
              {
                "group": ["**/reexec.ts", "./reexec.ts"],
                "message": "Only src/main.ts re-executes the process."
              },
              {
                "group": ["./server/*", "../server/*", "../../server/*", "../../../server/*"],
                "message": "Only src/main.ts composes the server; the core and clients never import it."
              },
              {
                "group": ["../telemetry/*", "../../telemetry/*", "../../../telemetry/*"],
                "message": "src/telemetry writes the core's log files; clients send telemetry through Client.record."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "Shared with browser clients: no Node modules."
              },
              {
                "group": ["**/core/*", "**/core/**", "**/tui/*"],
                "message": "src/ui depends on src/api, never on the core or a client."
              },
              {
                "group": ["**/test/*", "../test/*"],
                "message": "Source never imports test code."
              },
              {
                "group": ["**/reexec.ts", "./reexec.ts"],
                "message": "Only src/main.ts re-executes the process."
              },
              {
                "group": ["./server/*", "../server/*", "../../server/*", "../../../server/*"],
                "message": "Only src/main.ts composes the server; the core and clients never import it."
              },
              {
                "group": ["../telemetry/*", "../../telemetry/*", "../../../telemetry/*"],
                "message": "src/telemetry writes the core's log files; clients send telemetry through Client.record."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/tui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/core/*", "**/core/**"],
                "message": "Clients reach the core only through src/api."
              },
              {
                "group": ["**/test/*", "../test/*"],
                "message": "Source never imports test code."
              },
              {
                "group": ["**/reexec.ts", "./reexec.ts"],
                "message": "Only src/main.ts re-executes the process."
              },
              {
                "group": ["./server/*", "../server/*", "../../server/*", "../../../server/*"],
                "message": "Only src/main.ts composes the server; the core and clients never import it."
              },
              {
                "group": ["../telemetry/*", "../../telemetry/*", "../../../telemetry/*"],
                "message": "src/telemetry writes the core's log files; clients send telemetry through Client.record."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "src/web runs in a browser: no Node modules."
              },
              {
                "group": ["**/core/*", "**/core/**"],
                "message": "Clients reach the core only through src/api."
              },
              {
                "group": ["**/test/*", "../test/*"],
                "message": "Source never imports test code."
              },
              {
                "group": ["**/reexec.ts", "./reexec.ts"],
                "message": "Only src/main.ts re-executes the process."
              },
              {
                "group": ["./server/*", "../server/*", "../../server/*", "../../../server/*"],
                "message": "Only src/main.ts composes the server; the core and clients never import it."
              },
              {
                "group": ["../telemetry/*", "../../telemetry/*", "../../../telemetry/*"],
                "message": "src/telemetry writes the core's log files; clients send telemetry through Client.record."
              },
              {
                "group": ["../tui/*", "../../tui/*"],
                "message": "Clients never import each other."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["test/**", "vitest.config.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vitest",
                "importNames": ["vi", "vitest"],
                "message": "Tests exercise real Harnesses through Monchu's public seams; no mocks, spies, or stubs."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
